                "description": "Membuat Snap transaction dan mengembalikan URL pembayaran Midtrans.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Payment"
                ],
                "summary": "Buat pembayaran Midtrans",
                "parameters": [
                    {
                        "type": "string",
