                    "application/json"
                ],
                "tags": [
                    "Promo"
                ],
                "summary": "Detail promo",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Promo ID (UUID)",
                        "name": "id",
                        "in": "path",
