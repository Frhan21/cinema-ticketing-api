                    "application/json"
                ],
                "tags": [
                    "Promo"
                ],
                "summary": "Validasi kode promo",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Kode promo",
                        "name": "code",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Harga total sebelum diskon",
                        "name": "total_price",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
